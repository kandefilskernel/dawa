DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-moi-en-production
DJANGO_ALLOWED_HOSTS=*
DATABASE_HOST=db
DATABASE_NAME=dawa
DATABASE_USER=dawa
DATABASE_PASSWORD=dawa

# Mot de passe du compte portail de démonstration (seed_demo). Dev uniquement.
DAWA_DEMO_MOT_DE_PASSE=demo-pharmacie-2026

# Jetons d'appareil signés RSA. En dev : `manage.py generer_cle_rsa` crée backend/cles/jwt_prive.pem.
# En production : fournir la clé (PEM, \n pour les retours à la ligne) ou un chemin de fichier.
# JWT_CLE_PRIVEE=
# JWT_CLE_PRIVEE_FICHIER=/run/secrets/jwt_prive.pem
# Anciennes versions de l'app (en-tête X-Client-Id non signé) : 1 pendant la transition seulement.
DAWA_ACCEPTER_ANCIEN_CLIENT_ID=0
