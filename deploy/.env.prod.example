# Configuration de production. Copier en .env.prod sur le serveur et remplir. NE JAMAIS COMMITER .env.prod.

# Domaine public (le DNS doit pointer vers l'IP du serveur) et e-mail pour les certificats HTTPS.
DAWA_DOMAINE=dawa.exemple.cd
DAWA_EMAIL_ADMIN=admin@exemple.cd

DJANGO_ALLOWED_HOSTS=dawa.exemple.cd
DJANGO_CSRF_TRUSTED_ORIGINS=https://dawa.exemple.cd
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# HSTS : 3600 au début ; passer à 31536000 quand le HTTPS est stable.
DJANGO_HSTS_SECONDES=3600

DATABASE_NAME=dawa
DATABASE_USER=dawa
# Générer : python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DATABASE_PASSWORD=

# Jetons d'appareil : la clé est créée automatiquement dans le volume « cles » au premier démarrage.
DAWA_ACCEPTER_ANCIEN_CLIENT_ID=0

# E-mails (liens « mot de passe oublié » et alertes d'erreur). Ex. Brevo, Mailjet, Gmail (mot de passe d'application).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_UTILISATEUR=
EMAIL_MOT_DE_PASSE=
EMAIL_EXPEDITEUR=Dawa <ne-pas-repondre@dawa.exemple.cd>
# Qui reçoit un e-mail à chaque erreur serveur : « Nom:email,Nom2:email2 ».
DAWA_ALERTES_EMAILS=Equipe Dawa:admin@exemple.cd

# Numéro mobile money où les pharmacies paient leur abonnement.
DAWA_NUMERO_PAIEMENT=

# Facultatif : assistant IA du portail, webhook SMS/WhatsApp.
ANTHROPIC_API_KEY=
MESSAGERIE_JETON=

GUNICORN_WORKERS=3
